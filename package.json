{
  "name": "hikari-protocol",
  "version": "0.1.0",
  "description": "Stellar-native Liquid-Yield & Agentic Finance Protocol",
  "author": "ibochivincent-lang <ibochivincent-lang@users.noreply.github.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ibochivincent-lang/hikari.git"
  },
  "scripts": {
    "start": "node frontend/server.js",
    "dev": "node frontend/server.js",
    "serve": "node frontend/server.js",
    "dashboard": "node frontend/server.js",
    "daemon": "npm run daemon --prefix agents",
    "keeper:start": "node engine/dist/keeper_daemon.js",
    "test": "npm run test:contracts && npm run test:engine",
    "test:contracts": "node scripts/run_contracts_test.js",
    "test:engine": "npm test --prefix engine",
    "test:agents": "npm run simulate --prefix agents",
    "test:x402": "npm test --prefix services/x402-gateway",
    "test:sdk": "npm test --prefix sdk",
    "test:stress": "node scripts/simulate_stress_test.js",
    "test:testnet": "node scripts/test_live_cycle.js",
    "verify:testnet": "node scripts/deploy_testnet.js --verify",
    "test:fuzz": "node scripts/run_fuzz_tests.js",
    "test:backtest": "node scripts/run_backtest.js",
    "report:transparency": "node scripts/generate_transparency_report.js",
    "build:wasm": "powershell -ExecutionPolicy Bypass -File scripts/build_wasm.ps1",
    "bot:telegram": "node services/social-bot/dist/bot-telegram.js",
    "bot:discord": "node services/social-bot/dist/bot-discord.js",
    "bot:x": "node services/social-bot/dist/bot-x-broadcaster.js",
    "build:services": "node engine/node_modules/typescript/bin/tsc -p services/social-bot/tsconfig.json && node engine/node_modules/typescript/bin/tsc -p services/automation/tsconfig.json && node engine/node_modules/typescript/bin/tsc -p services/database/tsconfig.json",
    "keeper:harvest": "node services/automation/dist/harvest-keeper.js",
    "solvency:proof": "node services/automation/dist/merkle-solvency.js",
    "test:hakiru": "node scripts/verify_hakiru_full_suite.js"
  },
  "devDependencies": {
    "puppeteer-core": "^25.10.0"
  }
}
